# 仅供 PostgreSQL、Redis、迁移和受控 SQL.js 导入使用；请复制为受保护的运行环境变量。
POSTGRES_DB=ionailabs
POSTGRES_USER=ionailabs
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ionailabs:replace-with-a-long-random-password@127.0.0.1:5432/ionailabs
# POSTGRES_URL is a legacy compatibility alias. Leave it unset, or set it to exactly DATABASE_URL.
# POSTGRES_URL=postgresql://ionailabs:replace-with-a-long-random-password@127.0.0.1:5432/ionailabs

REDIS_PASSWORD=replace-with-a-different-long-random-password
REDIS_PORT=6379
REDIS_URL=redis://:replace-with-a-different-long-random-password@127.0.0.1:6379
REDIS_KEY_PREFIX=ionailabs

# PostgreSQL 运行模式拒绝使用默认 JWT 密钥；至少 32 字节并与旧系统登录密钥保持一致。
JWT_SECRET=replace-with-an-existing-or-new-32-byte-random-secret

# 流式请求：首字节与每次非空 SSE 数据后的空闲窗口均为 120 秒，总时长最多 15 分钟。
UPSTREAM_FIRST_BYTE_TIMEOUT_MS=120000
UPSTREAM_STREAM_IDLE_TIMEOUT_MS=120000
UPSTREAM_TOTAL_TIMEOUT_MS=900000
GATEWAY_LEASE_RENEW_INTERVAL_MS=30000
GATEWAY_LEASE_TTL_MS=180000
# 仅保留给非流式请求及旧配置兼容；流式请求请使用上面的细分配置。
UPSTREAM_TIMEOUT_MS=120000

# Worker 在写 heartbeat 前会校验迁移 checksum 并预建当前月及未来 3 个月日志分区。
REQUEST_LOG_RETENTION_DAYS=90
REQUEST_LOG_PARTITION_HORIZON_MONTHS=3
UPSTREAM_PROBE_CONCURRENCY=5
UPSTREAM_PROBE_RETENTION_DAYS=30
WORKER_TICK_INTERVAL_MS=10000
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_HEARTBEAT_TTL_SECONDS=90

# 32 字节随机密钥的 base64url 编码。JSON 可以保留旧版本以支持轮换后的解密。
INFRA_SECRET_ACTIVE_VERSION=v1
INFRA_SECRET_KEYRING={"v1":"replace-with-base64url-encoded-32-byte-key"}

# SQL.js 控制面导入默认 dry-run。只有 --apply 且下列确认值精确匹配时才会写入。
SQLJS_CONTROL_PLANE_SOURCE=./data/proxy.db
SQLJS_BACKUP_DIRECTORY=./backups/sqljs-control-plane
# 正式导入必须指向 backup:sqljs --apply 生成的 .sha256.json；导入程序会再次校验源库和备份哈希，并从备份读取。
SQLJS_CONTROL_PLANE_BACKUP_MANIFEST=./backups/sqljs-control-plane/<timestamp>/proxy.db.sha256.json
SQLJS_BACKUP_CONFIRM=do-not-set-until-reviewed
CONTROL_PLANE_IMPORT_CONFIRM=do-not-set-until-reviewed
INFRA_IMPORT_ACTOR=operator-name

BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
